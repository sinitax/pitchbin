[Unit]
Description=pitchbin
After=network.target

[Service]
Type=simple
User=pitchbin
Group=pitchbin
ExecStart=/usr/local/bin/pitchbin -addr :8080 -db /var/lib/pitchbin/pitchbin.db -base-url https://pitchbin.io
WorkingDirectory=/var/lib/pitchbin
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
